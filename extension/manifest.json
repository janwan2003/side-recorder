{
  "manifest_version": 3,
  "name": "Tapeline: test recorder for .side files",
  "short_name": "Tapeline",
  "version": "0.1.0",
  "description": "Record and replay browser tests. Opens and saves .side projects, exports Playwright, WebDriver and Cypress code. No account.",
  "action": {
    "default_title": "Open Tapeline",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting", "tabs", "contextMenus", "unlimitedStorage"],
  "optional_host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116"
}
