{
  "id": "6f1c1a52-1a0b-4c3e-9a51-2a3b4c5d6e7f",
  "version": "2.0",
  "name": "Shop checks",
  "url": "http://127.0.0.1:0",
  "tests": [{
    "id": "t-signup",
    "name": "Sign up",
    "commands": [
      { "id": "c1", "comment": "", "command": "open", "target": "/app.html", "targets": [], "value": "" },
      { "id": "c2", "comment": "", "command": "type", "target": "css=[data-testid=\"email\"]", "targets": [["css=[data-testid=\"email\"]", "css:data-attr"], ["id=email", "id"]], "value": "ada@example.com" },
      { "id": "c3", "comment": "", "command": "type", "target": "name=password", "targets": [], "value": "s3cret" },
      { "id": "c4", "comment": "pick the paid plan", "command": "select", "target": "id=plan", "targets": [], "value": "label=Pro" },
      { "id": "c5", "comment": "", "command": "click", "target": "id=terms", "targets": [], "value": "" },
      { "id": "c6", "comment": "", "command": "click", "target": "css=button[type=submit]", "targets": [], "value": "" },
      { "id": "c7", "comment": "", "command": "assertText", "target": "css=h1", "targets": [], "value": "Welcome, ada@example.com" },
      { "id": "c8", "comment": "", "command": "storeText", "target": "id=plan-name", "targets": [], "value": "plan" },
      { "id": "c9", "comment": "", "command": "if", "target": "${plan} === 'Pro'", "targets": [], "value": "" },
      { "id": "c10", "comment": "", "command": "echo", "target": "paid plan: ${plan}", "targets": [], "value": "" },
      { "id": "c11", "comment": "", "command": "else", "target": "", "targets": [], "value": "" },
      { "id": "c12", "comment": "", "command": "assert", "target": "plan", "targets": [], "value": "never" },
      { "id": "c13", "comment": "", "command": "end", "target": "", "targets": [], "value": "" },
      { "id": "c14", "comment": "", "command": "executeScript", "target": "return [1, 2, 3]", "targets": [], "value": "items" },
      { "id": "c15", "comment": "", "command": "executeScript", "target": "return 0", "targets": [], "value": "sum" },
      { "id": "c16", "comment": "", "command": "forEach", "target": "items", "targets": [], "value": "n" },
      { "id": "c17", "comment": "", "command": "executeScript", "target": "return ${sum} + ${n}", "targets": [], "value": "sum" },
      { "id": "c18", "comment": "", "command": "end", "target": "", "targets": [], "value": "" },
      { "id": "c19", "comment": "", "command": "assert", "target": "sum", "targets": [], "value": "6" },
      { "id": "c20", "comment": "", "command": "click", "target": "id=alert-btn", "targets": [], "value": "" },
      { "id": "c21", "comment": "", "command": "assertAlert", "target": "Saved!", "targets": [], "value": "" },
      { "id": "c22", "comment": "", "command": "click", "target": "linkText=Settings", "targets": [], "value": "" },
      { "id": "c23", "comment": "", "command": "assertTitle", "target": "Settings", "targets": [], "value": "" },
      { "id": "c24", "comment": "", "command": "//click", "target": "id=gone", "targets": [], "value": "" }
    ]
  }],
  "suites": [{ "id": "s1", "name": "Default Suite", "persistSession": false, "parallel": false, "timeout": 300, "tests": ["t-signup"] }],
  "urls": ["http://127.0.0.1:0"],
  "plugins": [],
  "x-custom-field": { "kept": true }
}
